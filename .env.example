# Copy this file to .env and fill in the keys. .env is git-ignored: never commit real keys.

# Stock footage: https://pixabay.com/api/docs/  (free). Without it only your own library is used.
PIXABAY_API_KEY=

# Line scoring, picture check, start-moment choice: https://aistudio.google.com/apikey
# Without it the offline engine runs (weaker picks, no picture check).
GEMINI_API_KEY=

# Line scoring with Jev (TypeSafe's decision model, via OpenRouter): https://openrouter.ai/settings/keys
# Used when Gemini is absent or fails: Jev scores each line (filmable? how important? which role?) with calibrated
# probabilities, much cheaper than an LLM. Text only, so the picture check still needs GEMINI_API_KEY.
OPENROUTER_API_KEY=

# Optional
# JEV_MODEL=typesafe/jev-1.13           # or ~typesafe/jev-latest
# EPOCH_SCORER=jev                      # which engine scores lines first: gemini (default) | jev | offline
# GEMINI_MODEL=gemini-flash-latest      # tried first; the app rotates across current Flash models anyway
# WHISPER_MODEL=base                    # default "small"; "base" is faster and a little less accurate
# EPOCH_INDEXER=0                       # 1 (default) runs the background indexing worker inside the server
